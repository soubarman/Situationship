rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.get('admin', false) == true;
    }

    function isNotSuspended() {
      return isAuthenticated() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isSuspended', false) != true
      );
    }

    function getOtherUid(participants, myUid) {
      return participants[0] == myUid ? participants[1] : participants[0];
    }

    function areNotMutuallyBlocked(user1, user2) {
      return (!exists(/databases/$(database)/documents/users/$(user1)) || !(user2 in get(/databases/$(database)/documents/users/$(user1)).data.get('blockedUsers', []))) &&
             (!exists(/databases/$(database)/documents/users/$(user2)) || !(user1 in get(/databases/$(database)/documents/users/$(user2)).data.get('blockedUsers', [])));
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // ── USERS COLLECTION ────────────────────────────────────────────────────────
    match /users/{userId} {
      // PII Protection: Private details (email, unrevealed phone number, sensitive account data)
      // must not be visible to unauthorized users.
      // Owner and Admin can read full profile. Non-owners can read profile documents
      // provided they are authenticated and not mutually blocked.
      allow read: if isNotSuspended() && (
        isOwner(userId) ||
        isAdmin() ||
        areNotMutuallyBlocked(request.auth.uid, userId)
      );

      // User creation: STRICT SCHEMA ALLOWLIST and privileged zero-defaults
      // NOTE: PII fields (email, phoneNumber) are strictly forbidden on public user documents.
      // They must be stored in users/{userId}/private/profile.
      allow create: if isOwner(userId) &&
        request.resource.data.keys().hasOnly([
          'id', 'name', 'bio', 'age', 'location', 'gender',
          'isPhonePublic', 'phoneVisibilityVersion', 'avatarUrl', 'interests', 'photos',
          'followers', 'following', 'likedBy', 'superLikedBy', 'matches', 'postCount',
          'isOnline', 'lastSeen', 'createdAt', 'isVerified', 'isSubscribed', 'coins',
          'totalEarnedCoins', 'claimedMilestones', 'role', 'isSuspended', 'joinedCommunities',
          'currentCityId', 'homeCityId', 'campusId', 'interestedIn', 'relationshipIntent',
          'blockedUsers', 'isDiscoverable', 'dealbreakers', 'dailyLoginStreak', 'conversationRewardsToday',
          'unlockedUserPhones', 'unlockedVisitors', 'subscriptionExpiry', 'phoneUnlocksUsed', 'phoneUnlockQuota',
          'lastLoginDate', 'dislikedUsers'
        ]) &&
        request.resource.data.get('isVerified', false) == false &&
        request.resource.data.get('isSubscribed', false) == false &&
        request.resource.data.get('isSuspended', false) == false &&
        request.resource.data.get('coins', 0) == 0 &&
        request.resource.data.get('totalEarnedCoins', 0) == 0 &&
        request.resource.data.get('claimedMilestones', []).size() == 0 &&
        request.resource.data.get('role', 'user') == 'user' &&
        request.resource.data.get('unlockedUserPhones', []).size() == 0 &&
        request.resource.data.get('unlockedVisitors', []).size() == 0 &&
        request.resource.data.get('dailyLoginStreak', 0) <= 1 &&
        request.resource.data.get('conversationRewardsToday', 0) == 0 &&
        request.resource.data.get('phoneUnlocksUsed', 0) == 0 &&
        request.resource.data.get('phoneUnlockQuota', 0) == 0 &&
        request.resource.data.get('subscriptionExpiry', null) == null;

      // User updates:
      // Case 1: Owner update using STRICT ALLOWLIST of safe personal profile fields.
      // Privileged fields (coins, rewards, subscriptions, verification, streak, unlocks, milestones) are excluded.
      // Case 2: Swiper/Liker appending ONLY their own UID to likedBy, followers, or superLikedBy.
      // Case 3: Administrator
      allow update: if isAdmin() || (
        isNotSuspended() && (
          // Owner update: Strictly constrained to safe profile fields (reward/payment/verification/PII excluded)
          (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'bio', 'age', 'location', 'avatarUrl', 'interests', 'photos',
            'zodiacSign', 'isOnline', 'lastSeen', 'postCount', 'joinedCommunities',
            'currentCityId', 'homeCityId', 'campusId', 'gender', 'interestedIn',
            'relationshipIntent', 'blockedUsers', 'isDiscoverable', 'dealbreakers',
            'isPhonePublic', 'phoneVisibilityVersion', 'following', 'dislikedUsers',
            'matches'
          ]))
          ||
          // Non-owner swipe interaction: strictly appending own UID without removing or replacing existing elements
          (!isOwner(userId) &&
           areNotMutuallyBlocked(request.auth.uid, userId) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers', 'likedBy', 'superLikedBy', 'superLikeNotes']) &&
           request.resource.data.get('likedBy', []).hasAll(resource.data.get('likedBy', [])) &&
           request.resource.data.get('followers', []).hasAll(resource.data.get('followers', [])) &&
           request.resource.data.get('superLikedBy', []).hasAll(resource.data.get('superLikedBy', [])) &&
           request.resource.data.get('likedBy', []).toSet().difference(resource.data.get('likedBy', []).toSet()).hasOnly([request.auth.uid]) &&
           request.resource.data.get('followers', []).toSet().difference(resource.data.get('followers', []).toSet()).hasOnly([request.auth.uid]) &&
           request.resource.data.get('superLikedBy', []).toSet().difference(resource.data.get('superLikedBy', []).toSet()).hasOnly([request.auth.uid]) &&
           request.resource.data.get('likedBy', []).size() <= resource.data.get('likedBy', []).size() + 1 &&
           request.resource.data.get('followers', []).size() <= resource.data.get('followers', []).size() + 1 &&
           request.resource.data.get('superLikedBy', []).size() <= resource.data.get('superLikedBy', []).size() + 1 &&
           (!('superLikeNotes' in request.resource.data.diff(resource.data).affectedKeys()) ||
            request.resource.data.superLikeNotes.diff(resource.data.get('superLikeNotes', {})).affectedKeys().hasOnly([request.auth.uid]))
          )
        )
      );

      allow delete: if isAdmin() || isOwner(userId);

      // Private data subcollection: Strictly owner-only and admin read/write
      // Used for sensitive contact information (email, phoneNumber), billing tokens, and private settings
      match /private/{document} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Unlocked contacts subcollection: Contains authorized contact reveals created by backend/admin
      // Readable by:
      // 1. Admin
      // 2. Account owner (userId)
      // 3. Authorized viewer (viewerId) IF:
      //    - Requester is authenticated and not suspended
      //    - Mutual blocking checks pass (neither user has blocked the other)
      //    - Target user document exists
      //    - Target user currently has isPhonePublic == true
      //    - Stored phoneVisibilityVersion on unlock document matches target user's current phoneVisibilityVersion
      match /unlocked_contacts/{viewerId} {
        allow read: if isNotSuspended() && (
          isAdmin() ||
          isOwner(userId) ||
          (
            request.auth.uid == viewerId &&
            areNotMutuallyBlocked(request.auth.uid, userId) &&
            exists(/databases/$(database)/documents/users/$(userId)) &&
            get(/databases/$(database)/documents/users/$(userId)).data.get('isPhonePublic', false) == true &&
            resource.data.get('phoneVisibilityVersion', 0) == get(/databases/$(database)/documents/users/$(userId)).data.get('phoneVisibilityVersion', 0)
          )
        );
        allow write: if isAdmin();
      }
    }

    // ── CHATS & DIRECT MESSAGES ────────────────────────────────────────────────
    match /chats/{chatId} {
      // Blocking works for existing conversations: participants cannot read if blocked
      allow read: if isNotSuspended() &&
                  resource != null && 'participants' in resource.data &&
                  request.auth.uid in resource.data.participants &&
                  areNotMutuallyBlocked(request.auth.uid, getOtherUid(resource.data.participants, request.auth.uid));

      // Chat Creation: Requires mutual match or incoming like/super-like, exactly 2 participants, and no blocks
      allow create: if isNotSuspended() &&
                    request.auth.uid in request.resource.data.participants &&
                    request.resource.data.participants.size() == 2 &&
                    request.resource.data.participants[0] != request.resource.data.participants[1] &&
                    (
                      request.auth.uid in get(/databases/$(database)/documents/users/$(getOtherUid(request.resource.data.participants, request.auth.uid))).data.get('likedBy', []) ||
                      request.auth.uid in get(/databases/$(database)/documents/users/$(getOtherUid(request.resource.data.participants, request.auth.uid))).data.get('superLikedBy', []) ||
                      getOtherUid(request.resource.data.participants, request.auth.uid) in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('likedBy', []) ||
                      isAdmin()
                    ) &&
                    areNotMutuallyBlocked(request.auth.uid, getOtherUid(request.resource.data.participants, request.auth.uid)) &&
                    request.resource.data.keys().hasOnly([
                      'id', 'participants', 'status', 'requestSenderId', 'senderId', 'senderName', 'senderAvatar',
                      'receiverId', 'receiverName', 'receiverAvatar', 'otherUserId', 'otherUserName', 'otherUserAvatar',
                      'otherUserIsOnline', 'lastMessage', 'lastMessageTime', 'unreadCount', 'isExpired', 'expiresIn',
                      'acceptedAt', 'isConfession', 'revealStatus'
                    ]) &&
                    request.resource.data.get('status', 'requested') in ['requested', 'accepted'] &&
                    request.resource.data.get('revealStatus', null) in [null, 'requested', 'revealed', 'declined'];

      // Chat metadata update: Participants immutable, blocked users cannot update
      allow update: if isNotSuspended() &&
                    resource != null && 'participants' in resource.data &&
                    request.auth.uid in resource.data.participants &&
                    areNotMutuallyBlocked(request.auth.uid, getOtherUid(resource.data.participants, request.auth.uid)) &&
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants', 'id']) &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'lastMessage', 'lastMessageTime', 'unreadCount', 'status', 'revealStatus', 'isConfession', 'acceptedAt'
                    ]) &&
                    request.resource.data.get('status', resource.data.get('status', 'accepted')) in ['requested', 'accepted', 'blocked'] &&
                    request.resource.data.get('revealStatus', null) in [null, 'requested', 'revealed', 'declined'] &&
                    request.resource.data.get('unreadCount', 0) >= 0;

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isNotSuspended() &&
                    request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                    areNotMutuallyBlocked(request.auth.uid, getOtherUid(get(/databases/$(database)/documents/chats/$(chatId)).data.participants, request.auth.uid));

        allow create: if isNotSuspended() &&
                      request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                      request.resource.data.senderId == request.auth.uid &&
                      request.resource.data.senderId != 'anonymous' &&
                      request.resource.data.get('type', 'text') in ['text', 'image', 'emoji', 'audio', 'sticker'] &&
                      request.resource.data.keys().hasOnly(['id', 'senderId', 'text', 'imageUrl', 'createdAt', 'isRead', 'readAt', 'type', 'reactions']) &&
                      areNotMutuallyBlocked(request.auth.uid, getOtherUid(get(/databases/$(database)/documents/chats/$(chatId)).data.participants, request.auth.uid));

        // Sender editing only text; Recipient marking read or updating reactions with own UID
        allow update: if isNotSuspended() &&
                      request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                      areNotMutuallyBlocked(request.auth.uid, getOtherUid(get(/databases/$(database)/documents/chats/$(chatId)).data.participants, request.auth.uid)) &&
                      request.resource.data.senderId == resource.data.senderId &&
                      request.resource.data.get('type', 'text') == resource.data.get('type', 'text') && (
                        // Sender editing only text
                        (resource.data.senderId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])) ||
                        // Recipient marking read or updating reaction strictly mapped to caller UID
                        (resource.data.senderId != request.auth.uid && (
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']) ||
                          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) &&
                           request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])) ||
                          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt', 'reactions']) &&
                           request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid]))
                        )) ||
                        isAdmin()
                      );

        allow delete: if isAdmin() || (isNotSuspended() && resource.data.senderId == request.auth.uid);
      }
    }

    // ── COMMUNITIES ────────────────────────────────────────────────────────────
    match /communities/{communityId} {
      allow read: if isNotSuspended();
      // Community creation: creator must be caller
      allow create: if isNotSuspended() && (request.resource.data.get('adminId', request.resource.data.get('createdBy', '')) == request.auth.uid);
      
      // Community updates:
      // Admin/Creator can update all community metadata
      // Non-admins can ONLY join/leave via atomic memberAvatars/memberCount mutation,
      // or request approval in pendingApprovals.
      // Direct self-escalation or arbitrary memberCount modification is forbidden.
      allow update: if isNotSuspended() && (
        (resource.data.get('adminId', resource.data.get('createdBy', '')) == request.auth.uid) ||
        (
          resource.data.get('adminId', resource.data.get('createdBy', '')) != request.auth.uid &&
          (
            // Join: user appends self to memberAvatars, increments count by exactly 1
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'memberAvatars']) &&
             request.resource.data.memberAvatars.toSet().difference(resource.data.get('memberAvatars', []).toSet()).hasOnly([request.auth.uid]) &&
             request.resource.data.memberCount == resource.data.get('memberCount', 0) + 1) ||
            // Leave: user removes self from memberAvatars, decrements count by exactly 1
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'memberAvatars']) &&
             resource.data.get('memberAvatars', []).toSet().difference(request.resource.data.memberAvatars.toSet()).hasOnly([request.auth.uid]) &&
             request.resource.data.memberCount == resource.data.get('memberCount', 0) - 1) ||
            // Request approval: user appends self to pendingApprovals (count unchanged)
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingApprovals']) &&
             request.resource.data.pendingApprovals.toSet().difference(resource.data.get('pendingApprovals', []).toSet()).hasOnly([request.auth.uid]))
          )
        ) ||
        isAdmin()
      );
      allow delete: if isAdmin() || (resource.data.get('adminId', resource.data.get('createdBy', '')) == request.auth.uid);

      // Community rooms: verify membership
      match /rooms/{roomId} {
        allow read: if isNotSuspended() && (
          communityId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('joinedCommunities', []) ||
          request.auth.uid in get(/databases/$(database)/documents/communities/$(communityId)).data.get('memberAvatars', []) ||
          get(/databases/$(database)/documents/communities/$(communityId)).data.get('adminId', get(/databases/$(database)/documents/communities/$(communityId)).data.get('createdBy', '')) == request.auth.uid ||
          isAdmin()
        );
        allow write: if isNotSuspended() && (
          get(/databases/$(database)/documents/communities/$(communityId)).data.get('adminId', get(/databases/$(database)/documents/communities/$(communityId)).data.get('createdBy', '')) == request.auth.uid ||
          isAdmin()
        );
      }

      // Community messages: verify membership and sender identity
      match /messages/{messageId} {
        allow read: if isNotSuspended() && (
          communityId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('joinedCommunities', []) ||
          request.auth.uid in get(/databases/$(database)/documents/communities/$(communityId)).data.get('memberAvatars', []) ||
          get(/databases/$(database)/documents/communities/$(communityId)).data.get('adminId', get(/databases/$(database)/documents/communities/$(communityId)).data.get('createdBy', '')) == request.auth.uid ||
          isAdmin()
        );
        allow create: if isNotSuspended() &&
                      request.resource.data.senderId == request.auth.uid &&
                      (communityId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('joinedCommunities', []) ||
                       request.auth.uid in get(/databases/$(database)/documents/communities/$(communityId)).data.get('memberAvatars', []) ||
                       get(/databases/$(database)/documents/communities/$(communityId)).data.get('adminId', get(/databases/$(database)/documents/communities/$(communityId)).data.get('createdBy', '')) == request.auth.uid);
        allow update: if isNotSuspended() && (
          (resource.data.senderId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])) ||
          isAdmin()
        );
        allow delete: if isNotSuspended() && (
          resource.data.senderId == request.auth.uid ||
          get(/databases/$(database)/documents/communities/$(communityId)).data.get('adminId', get(/databases/$(database)/documents/communities/$(communityId)).data.get('createdBy', '')) == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // ── POSTS & COMMENTS ───────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if isNotSuspended();
      allow create: if isNotSuspended() && request.resource.data.userId == request.auth.uid;

      // Restrict owner updates; enforce interaction constraints (prevent arbitrary commentCount manipulation)
      allow update: if isNotSuspended() && (
        // Owner update: safe fields only
        (resource.data.userId == request.auth.uid &&
         request.resource.data.userId == resource.data.userId &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'caption', 'mood', 'moodEmoji', 'moodLabel', 'tags', 'location', 'isPinned',
           'privacy', 'isEdited', 'musicTrack', 'musicArtist', 'likes', 'reactions',
           'commentCount', 'planParticipants'
         ]) &&
         (!('commentCount' in request.resource.data.diff(resource.data).affectedKeys()) ||
          request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1 ||
          request.resource.data.commentCount == resource.data.get('commentCount', 0) - 1)
        ) ||
        // Non-owner interaction: likes toggle, reactions update, increment/decrement commentCount by exactly 1
        (!isOwner(resource.data.userId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'reactions', 'commentCount', 'planParticipants']) &&
         (!('likes' in request.resource.data.diff(resource.data).affectedKeys()) ||
          request.resource.data.likes.toSet().difference(resource.data.get('likes', []).toSet()).hasOnly([request.auth.uid]) ||
          resource.data.get('likes', []).toSet().difference(request.resource.data.likes.toSet()).hasOnly([request.auth.uid])) &&
         (!('reactions' in request.resource.data.diff(resource.data).affectedKeys()) ||
          request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])) &&
         (!('commentCount' in request.resource.data.diff(resource.data).affectedKeys()) ||
          request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1 ||
          request.resource.data.commentCount == resource.data.get('commentCount', 0) - 1)
        ) ||
        isAdmin()
      );
      allow delete: if isNotSuspended() && (resource.data.userId == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if isNotSuspended();
        allow create: if isNotSuspended() && request.resource.data.userId == request.auth.uid;
        allow update: if isNotSuspended() && (
          (resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
           (request.resource.data.likes.toSet().difference(resource.data.get('likes', []).toSet()).hasOnly([request.auth.uid]) ||
            resource.data.get('likes', []).toSet().difference(request.resource.data.likes.toSet()).hasOnly([request.auth.uid])))
        );
        allow delete: if isNotSuspended() && (
          resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // ── STORIES ────────────────────────────────────────────────────────────────
    match /stories/{storyId} {
      allow read: if isNotSuspended();
      allow create: if isNotSuspended() && request.resource.data.userId == request.auth.uid;
      // Append-only viewers update or commentCount increment by 1
      allow update: if isNotSuspended() && (
        (resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption', 'commentCount'])) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers']) &&
          request.resource.data.get('viewers', []).hasAll(resource.data.get('viewers', [])) &&
          request.resource.data.get('viewers', []).toSet().difference(resource.data.get('viewers', []).toSet()).hasOnly([request.auth.uid]) &&
          request.resource.data.get('viewers', []).size() <= resource.data.get('viewers', []).size() + 1
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']) &&
          request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
        )
      );
      allow delete: if isNotSuspended() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ── NOTIFICATIONS ──────────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read, delete: if isNotSuspended() && resource.data.userId == request.auth.uid;
      allow update: if isNotSuspended() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      // Prevent generating fake match, system, or admin notifications from clients
      allow create: if isNotSuspended() &&
                    request.resource.data.senderId == request.auth.uid &&
                    request.resource.data.userId != request.auth.uid &&
                    !(request.resource.data.get('type', 'standard') in ['match', 'system', 'admin']) &&
                    request.resource.data.keys().hasOnly(['id', 'userId', 'senderId', 'senderName', 'senderAvatar', 'type', 'title', 'body', 'createdAt', 'isRead']) &&
                    areNotMutuallyBlocked(request.auth.uid, request.resource.data.userId);
    }

    // ── BOOSTS & ANALYTICS ─────────────────────────────────────────────────────
    match /boosts/{boostId} {
      allow read: if isNotSuspended();
      // Paid boosts must be verified and created server-side
      allow create, update, delete: if isAdmin();

      match /boost_analytics/{eventId} {
        allow read: if isNotSuspended() && (get(/databases/$(database)/documents/boosts/$(boostId)).data.ownerUserId == request.auth.uid || isAdmin());
        allow create: if isNotSuspended() &&
                      request.resource.data.get('userId', '') == request.auth.uid &&
                      request.resource.data.get('boostId', '') == boostId &&
                      request.resource.data.keys().hasOnly(['id', 'userId', 'boostId', 'type', 'targetUserId', 'timestamp', 'cityId', 'metadata']);
        allow update, delete: if false;
      }
    }

    // ── SPOTLIGHT SESSIONS & BIDS (SERVER MANAGED) ─────────────────────────────
    match /spotlight_sessions/{sessionId} {
      allow read: if isNotSuspended();
      allow write: if isAdmin();

      match /bids/{bidId} {
        allow read: if isNotSuspended();
        allow write: if isAdmin();
      }
    }

    // ── VERIFICATIONS ──────────────────────────────────────────────────────────
    match /verifications/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    match /challenges/{challengeId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if isAdmin();
    }

    match /verification_audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── COIN REWARDS & MILESTONES ──────────────────────────────────────────────
    match /coin_rewards/{rewardId} {
      allow read: if isNotSuspended() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /coin_milestones/{milestoneId} {
      allow read: if isNotSuspended() && (resource.data.userId == request.auth.uid || isAdmin());
      // User can create milestone claim only if eligible, pending status, and no giftCode
      // Milestone eligibility requires verified totalEarnedCoins >= threshold
      allow create: if isNotSuspended() &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.status == 'pending' &&
                    request.resource.data.milestoneId in ['spark', 'glow', 'icon', 'legend'] &&
                    (!('giftCode' in request.resource.data) || request.resource.data.giftCode == null) &&
                    request.resource.data.keys().hasOnly(['userId', 'milestoneId', 'milestoneName', 'giftCardValueInr', 'status', 'giftCode', 'createdAt']) &&
                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('totalEarnedCoins', 0) >= (
                      request.resource.data.milestoneId == 'spark' ? 500 : (
                        request.resource.data.milestoneId == 'glow' ? 1500 : (
                          request.resource.data.milestoneId == 'icon' ? 3000 : 6000
                        )
                      )
                    );
      allow update, delete: if isAdmin();
    }

    // ── REPORTS & PROFILE VIEWS ────────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if isNotSuspended() && request.resource.data.reportedBy == request.auth.uid;
      allow read: if isAdmin() || (isAuthenticated() && resource.data.reportedBy == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /profile_views/{viewId} {
      allow read: if isNotSuspended() && (
        resource.data.viewerId == request.auth.uid ||
        resource.data.targetId == request.auth.uid ||
        isAdmin()
      );
      // Validate profile-view target ID, immutable visitor identity
      allow create: if isNotSuspended() &&
                    request.resource.data.viewerId == request.auth.uid &&
                    request.resource.data.targetId != request.auth.uid &&
                    exists(/databases/$(database)/documents/users/$(request.resource.data.targetId)) &&
                    viewId == request.auth.uid + '_' + request.resource.data.targetId &&
                    areNotMutuallyBlocked(request.auth.uid, request.resource.data.targetId) &&
                    request.resource.data.keys().hasOnly(['id', 'viewerId', 'viewerName', 'viewerAvatar', 'targetId', 'viewedAt', 'timestamp']);
      allow update: if false; // Immutable audit log
      allow delete: if isAdmin() || (isNotSuspended() && resource.data.viewerId == request.auth.uid);
    }
  }
}
