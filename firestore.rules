rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to verify if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to verify if the user is the designated admin
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email == 'situationship@gmail.com';
    }

    // ── Users ──────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Users can only modify their own documents; admin can modify any.
      allow update, delete: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // ── Profile Views ──────────────────────────────────────────────────────────
    match /profile_views/{viewId} {
      // Anyone authenticated can read or create a view
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.viewerId == request.auth.uid;
      // You can update a view you created (or Firebase merge operations might require update permission)
      allow update: if isAuthenticated() && resource.data.viewerId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.viewerId == request.auth.uid;
    }

    // ── Posts ──────────────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if isAuthenticated();
      // Only allow creation if the userId in the document matches the authenticated user
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Only the author can update their post, or anyone can update ONLY the likes/reactions/comments
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'reactions', 'commentCount']))
      );
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']))
        );
        allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }
    }

    // ── Communities ────────────────────────────────────────────────────────────
    match /communities/{communityId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.adminId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.adminId == request.auth.uid;

      match /rooms/{roomId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && get(/databases/$(database)/documents/communities/$(communityId)).data.adminId == request.auth.uid;
      }
      
      // Messages inside community
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
      }
    }

    // ── Chats ──────────────────────────────────────────────────────────────────
    match /chats/{chatId} {
      // Only participants can read or create/update the chat
      allow read, update: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
      }
    }

    // ── Stories ────────────────────────────────────────────────────────────────
    match /stories/{storyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers'])
      );
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ── Notifications ──────────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      // Users can only read their own notifications
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Anyone can create a notification for someone else
      allow create: if isAuthenticated();
    }

    // ── Boosts ──────────────────────────────────────────────────────────────────
    match /boosts/{boostId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerUserId == request.auth.uid && request.resource.data.contentType != 'plan';
      allow update, delete: if isAuthenticated() && resource.data.ownerUserId == request.auth.uid;

      match /boost_analytics/{eventId} {
        allow read: if isAuthenticated() && get(/databases/$(database)/documents/boosts/$(boostId)).data.ownerUserId == request.auth.uid;
        allow create: if isAuthenticated();
      }
    }

    // ── Spotlight ──────────────────────────────────────────────────────────────
    match /spotlight_sessions/{sessionId} {
      allow read: if isAuthenticated();
      // Creating or updating a session (incrementing prize pool) is allowed
      allow create, update: if isAuthenticated();
      allow delete: if false;

      match /bids/{bidId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() 
                              && bidId == request.auth.uid
                              && request.resource.data.userId == request.auth.uid
                              && request.resource.data.amount > 0;
        allow delete: if false; // Bids cannot be deleted once placed
      }
    }

    // ── Verifications ─────────────────────────────────────────────────────────
    // Users can read their own verification status.
    // Admin email or backend service account (Admin SDK) can read all & write.
    match /verifications/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        request.auth.token.admin == true ||
        isAdmin()
      );
      // Only admin dashboard can update (approve/reject); backend writes via Admin SDK
      allow write: if isAdmin();
    }

    // ── Challenges ────────────────────────────────────────────────────────────
    // Users can read their own challenges.
    // Challenges are created by the backend.
    match /challenges/{challengeId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow write: if false; // Backend only
    }

    // ── Verification Audit Logs ───────────────────────────────────────────────
    // Only admins can read audit logs. No client writes.
    match /verification_audit_logs/{logId} {
      allow read: if isAuthenticated() && (
        request.auth.token.admin == true ||
        isAdmin()
      );
      allow write: if false;
    }

    // ── Coin Rewards ──────────────────────────────────────────────────────────
    match /coin_rewards/{rewardId} {
      allow read, write: if isAuthenticated() && request.auth.uid == resource.data.userId || isAdmin();
      allow create: if isAuthenticated();
    }

    // ── Coin Milestones ───────────────────────────────────────────────────────
    match /coin_milestones/{milestoneId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAuthenticated() || isAdmin();
    }
    // ── Reports ───────────────────────────────────────────────────────────────
    // Any authenticated user can create a report for themselves.
    // Admin can read and update all reports (resolve/dismiss).
    // Reporter can read their own reports.
    match /reports/{reportId} {
      allow create: if isAuthenticated() &&
                    request.resource.data.reportedBy == request.auth.uid;
      allow read: if isAdmin() ||
                  (isAuthenticated() && resource.data.reportedBy == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

  }
}
