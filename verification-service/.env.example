
# ─────────────────────────────────────────────────────────────────
# App Settings
# ─────────────────────────────────────────────────────────────────
APP_NAME=Situationship Verification Service
DEBUG=false
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING

# ─────────────────────────────────────────────────────────────────
# Firebase
# ─────────────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON=/app/firebase-service-account.json
FIREBASE_PROJECT_ID=situation-ship
FIREBASE_STORAGE_BUCKET=situation-ship.appspot.com

# ─────────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─────────────────────────────────────────────────────────────────
# CORS — your Netlify URL (no trailing slash)
# ─────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["https://your-app.netlify.app"]

# ─────────────────────────────────────────────────────────────────
# Verification Pipeline
# ─────────────────────────────────────────────────────────────────
MAX_VERIFICATION_ATTEMPTS=5
ATTEMPT_COOLDOWN_HOURS=24
CHALLENGE_TTL_SECONDS=900

AUTO_APPROVE_THRESHOLD=0.82
MANUAL_REVIEW_THRESHOLD=0.65

VIDEO_MAX_DURATION_SECONDS=15
VIDEO_MAX_SIZE_MB=50
VIDEO_RETENTION_DAYS=7
DELETE_VIDEO_ON_APPROVE=true

# ─────────────────────────────────────────────────────────────────
# ML Models
# ─────────────────────────────────────────────────────────────────
INSIGHTFACE_MODEL_PACK=antelopev2
MODEL_DIR=/app/models
LIVENESS_MODEL_PATH=/app/models/liveness/2.7_80x80_MiniFASNetV2.onnx
LIVENESS_MODEL_PATH_2=/app/models/liveness/4_0_0_80x80_MiniFASNetV1SE.onnx

# ─────────────────────────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────────────────────────
RATE_LIMIT_VERIFY=3/day
RATE_LIMIT_CHALLENGE=10/hour
RATE_LIMIT_STATUS=60/minute

# ─────────────────────────────────────────────────────────────────
# Admin (comma-separated email list)
# ─────────────────────────────────────────────────────────────────
ADMIN_EMAILS=["your-admin@email.com"]
