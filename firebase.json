{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "situation-ship",
          "appId": "1:990817672883:android:1083950ec63b0e5b4c9ac6",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "situation-ship",
          "configurations": {
            "android": "1:990817672883:android:1083950ec63b0e5b4c9ac6",
            "web": "1:990817672883:web:b9d16252fcd56fee4c9ac6"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": false
    }
  },
  "functions": {
    "source": "functions",
    "codebase": "default",
    "runtime": "python311",
    "ignore": [
      "venv",
      ".git",
      "firebase-debug.log",
      "firestore-debug.log"
    ]
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
