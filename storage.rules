rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // ── Helper Functions ────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.get('admin', false) == true;
    }

    // Helper to get chat document data from (default) database
    function getChatData(chatId) {
      return firestore.get(/databases/(default)/documents/chats/$(chatId)).data;
    }

    // In Phase 4B: Mutual block check for chat participants
    function areChatParticipantsNotMutuallyBlocked(userA, userB) {
      return (!firestore.exists(/databases/(default)/documents/users/$(userA)) ||
              !(userB in firestore.get(/databases/(default)/documents/users/$(userA)).data.blockedUsers)) &&
             (!firestore.exists(/databases/(default)/documents/users/$(userB)) ||
              !(userA in firestore.get(/databases/(default)/documents/users/$(userB)).data.blockedUsers));
    }

    function isChatParticipantAndNotBlocked(chatId) {
      return isAuthenticated() &&
             request.auth.uid in getChatData(chatId).participants &&
             getChatData(chatId).status != 'blocked';
    }

    // Community membership: Verified using trusted community creator or subcollection / admin check
    function isCommunityMemberOrAdmin(communityId) {
      return isAuthenticated() && (
        request.auth.uid == firestore.get(/databases/(default)/documents/communities/$(communityId)).data.adminId ||
        request.auth.uid == firestore.get(/databases/(default)/documents/communities/$(communityId)).data.createdBy ||
        firestore.exists(/databases/(default)/documents/communities/$(communityId)/members/$(request.auth.uid)) ||
        isAdmin()
      );
    }

    // Default rule: reject all unmatched paths
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // ── Avatars (Profile Photos) ──────────────────────────────────────────────
    match /avatars/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated()
                   && fileName.matches('^' + request.auth.uid + '.*')
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isAuthenticated() && (
        fileName.matches('^' + request.auth.uid + '.*') || isAdmin()
      );
    }

    match /users/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId)
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ── UID-based paths for posts, stories, voice notes (Strictly Protected) ─
    match /posts/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(userId)
                            && request.resource.size < 50 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*|video/.*');
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /stories/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(userId)
                            && request.resource.size < 50 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*|video/.*');
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /voice_notes/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId)
                            && request.resource.size < 20 * 1024 * 1024
                            && request.resource.contentType.matches('audio/.*|video/.*');
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ── Communities (UID / CommunityId based scoped path) ─────────────────────
    match /communities/{communityId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isCommunityMemberOrAdmin(communityId)
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isAuthenticated() && (
        request.auth.uid == firestore.get(/databases/(default)/documents/communities/$(communityId)).data.adminId ||
        request.auth.uid == firestore.get(/databases/(default)/documents/communities/$(communityId)).data.createdBy ||
        isAdmin()
      );
    }

    // NOTE: All flat paths (/posts/{fileName}, /stories/{fileName}, /voice_notes/{fileName}, /communities/{fileName})
    // have been permanently removed for Phase 4B security remediation.

    // ── Chat attachments (Private to Participants & Unblocked) ────────────────
    match /chats/{chatId}/{fileName} {
      allow read: if isChatParticipantAndNotBlocked(chatId);
      allow create: if isChatParticipantAndNotBlocked(chatId)
                    && request.resource.size < 50 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*|video/.*|audio/.*');
      allow update: if false; // Attachments are immutable
      allow delete: if isAdmin();
    }

    // ── Verification Videos (Private to Owner & Admin) ────────────────────────
    match /verifications/{userId}/{fileName} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isAdmin()
      );
      allow create: if isAuthenticated()
                    && request.auth.uid == userId
                    && request.resource.size < 50 * 1024 * 1024
                    && request.resource.contentType.matches('video/.*');
      allow update, delete: if false;
    }
  }
}
