rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Default rule: reject all
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Stories: users can only upload to stories/
    match /stories/{fileName} {
      // Anyone authenticated can view stories
      allow read: if isAuthenticated();
      
      // Allow upload if authenticated, file is an image or video, and size is < 50MB
      allow create: if isAuthenticated()
                    && request.resource.size < 50 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*|video/.*');
                    
      // Only owner can delete their stories (assuming fileName contains userId, or handled securely by logic)
      allow delete: if isAuthenticated();
    }

    // Profile Images: stored at users/{userId}/{fileName} OR avatars/{userId}.jpg
    match /users/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() 
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Avatars (used by edit_profile_screen, complete_profile_screen, firebase_auth_provider)
    match /avatars/{fileName} {
      allow read: if isAuthenticated();
      // Allow upload only if fileName starts with the user's uid
      allow write: if isAuthenticated()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Posts: images and videos
    match /posts/{fileName} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.size < 50 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*|video/.*');
      allow delete: if isAuthenticated();
    }

    // Voice notes
    match /voice_notes/{fileName} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.size < 20 * 1024 * 1024
                    && request.resource.contentType.matches('audio/.*|video/.*');
      allow delete: if isAuthenticated();
    }

    // Community images
    match /communities/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Chat attachments
    match /chats/{chatId}/{fileName} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.size < 50 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*|video/.*|audio/.*');
      allow delete: if isAuthenticated();
    }

    // Verification Videos: users upload their verification videos here
    match /verifications/{userId}/{fileName} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        request.auth.token.admin == true
      );
      allow create: if isAuthenticated()
                    && request.auth.uid == userId
                    && request.resource.size < 50 * 1024 * 1024
                    && request.resource.contentType.matches('video/.*');
      // No deletion or update by users; cleanup is done by backend/admin
      allow update, delete: if false;
    }
  }
}
